@{
    ViewData["Title"] = "Dashboard";
    Layout = null;

    var hora = DateTime.Now.Hour;
    var saludo = hora < 12 ? "Buenos días" : hora < 19 ? "Buenas tardes" : "Buenas noches";
    
    var cultura = new System.Globalization.CultureInfo("es-ES");
    var fechaActual = DateTime.Now;
    var diaSemana = cultura.TextInfo.ToTitleCase(fechaActual.ToString("dddd", cultura));
    var dia = fechaActual.Day;
    var mes = cultura.TextInfo.ToTitleCase(fechaActual.ToString("MMMM", cultura));
    var anio = fechaActual.Year;
    var fechaStr = $"{diaSemana}, {dia} De {mes} De {anio}";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CampusGo - Dashboard</title>
    <style>
        :root {
            --primary: #3b82f6;
            --primary-dark: #2563eb;
            --sidebar-width: 250px;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', system-ui, sans-serif;
        }

        body {
            display: flex;
            min-height: 100vh;
            background-color: #ffffff;
            color: #333;
        }

        .sidebar {
            width: var(--sidebar-width);
            border-right: 1px solid #f1f5f9;
            display: flex;
            flex-direction: column;
            padding: 2rem 0;
        }

        .sidebar-header {
            padding: 0 1.5rem 1.5rem 1.5rem;
            border-bottom: 1px solid #f1f5f9;
        }

        .brand-name {
            font-size: 22px;
            font-weight: 700;
            color: var(--primary-dark);
        }

        .brand-sub {
            font-size: 13px;
            color: #64748b;
            margin-top: 4px;
        }

        .sidebar-menu {
            list-style: none;
            padding: 1.5rem 1rem;
            flex: 1;
        }

        .sidebar-menu li {
            margin-bottom: 0.25rem;
        }

        .sidebar-menu a {
            display: flex;
            align-items: center;
            padding: 0.85rem 1rem;
            color: #64748b;
            text-decoration: none;
            border-radius: 8px;
            font-size: 14px;
            transition: all 0.2s;
            gap: 12px;
        }

        .sidebar-menu a:hover:not(.active) {
            background-color: #f8fafc;
            color: #334155;
        }

        .sidebar-menu a.active {
            background-color: var(--primary);
            color: #fff;
        }

        .menu-icon {
            width: 18px; 
            height: 18px;
            stroke: currentColor;
            stroke-width: 2;
            fill: none;
        }

        .main-content {
            flex: 1;
            padding: 2.5rem 3rem;
            overflow-y: auto;
        }

        .header-title {
            font-size: 32px;
            font-weight: 700;
            color: #1e293b;
            display: flex;
            align-items: center;
        }

        .header-date {
            color: #94a3b8;
            margin-top: 8px;
            font-size: 13px;
        }

        .summary-banner {
            background: linear-gradient(90deg, #1890ff, #00b4d8);
            border-radius: 12px;
            padding: 1.5rem 2rem;
            color: #fff;
            margin-top: 2rem;
            box-shadow: 0 4px 14px rgba(0, 180, 216, 0.2);
        }

        .summary-title {
            font-size: 16px;
            font-weight: 600;
        }

        .summary-sub {
            font-size: 13px;
            opacity: 0.9;
            margin-top: 4px;
            margin-bottom: 1.5rem;
        }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 1rem;
        }

        .stat-card {
            background: rgba(255, 255, 255, 0.15);
            padding: 1.25rem 1rem;
            border-radius: 8px;
        }

        .stat-number {
            font-size: 26px;
            font-weight: 700;
            line-height: 1;
        }

        .stat-label {
            font-size: 12px;
            opacity: 0.9;
            margin-top: 8px;
        }

        .section-title {
            font-size: 16px;
            font-weight: 700;
            margin: 2.5rem 0 1rem 0;
            color: #1e293b;
        }

        .quick-access-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 1.25rem;
        }

        .qa-card {
            background: #fff;
            border: 1px solid #f1f5f9;
            border-radius: 12px;
            padding: 1.25rem;
            position: relative;
            cursor: pointer;
            transition: transform 0.2s, box-shadow 0.2s;
            box-shadow: 0 2px 5px rgba(0,0,0,0.02);
            text-decoration: none;
        }

        .qa-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 12px -3px rgba(0,0,0,0.05);
            border-color: #e2e8f0;
        }

        .qa-icon-wrapper {
            width: 44px;
            height: 44px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 1.25rem;
            color: #fff;
        }

        .qa-icon-wrapper.tareas { background: #0ea5e9; }
        .qa-icon-wrapper.lugares { background: #22c55e; }
        .qa-icon-wrapper.eventos { background: #d946ef; }
        .qa-icon-wrapper.tips { background: #f97316; }

        .qa-title {
            font-weight: 600;
            color: #1e293b;
            font-size: 14px;
        }

        .qa-desc {
            font-size: 12px;
            color: #94a3b8;
            margin-top: 6px;
        }

        .qa-arrow {
            position: absolute;
            right: 1.25rem;
            top: 50%;
            transform: translateY(-50%);
            color: #cbd5e1;
            font-size: 18px;
        }

        .quote-banner {
            background: #f0fdf4;
            border: 1px solid #dcfce7;
            border-radius: 12px;
            padding: 1.5rem;
            text-align: center;
            margin-top: 2.5rem;
            color: #166534;
        }

        .quote-text {
            font-size: 14px;
            font-weight: 500;
        }

        .quote-sub {
            color: #34d399; 
            font-size: 12px;
            margin-top: 8px;
        }
    </style>
</head>
<body>

    <aside class="sidebar">
        <div class="sidebar-header">
            <div class="brand-name">CampusGo</div>
            <div class="brand-sub">Tu plataforma estudiantil</div>
        </div>
        <ul class="sidebar-menu">
            <li>
                <a href="#" class="active">
                    <svg class="menu-icon" viewBox="0 0 24 24"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
                    Inicio
                </a>
            </li>
            <li>
                <a href="/Tareas">
                    <svg class="menu-icon" viewBox="0 0 24 24"><polyline points="9 11 12 14 22 4"></polyline><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path></svg>
                    Tareas
                </a>
            </li>
            <li>
                <a href="/Lugares">
                    <svg class="menu-icon" viewBox="0 0 24 24"><path d="M17 3v18"></path><path d="M4 15h16"></path><path d="M3 3l18 18"></path><path d="M7 8l-4 4"></path></svg>
                    Lugares
                </a>
            </li>
            <li>
                <a href="/Eventos">
                    <svg class="menu-icon" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                    Eventos
                </a>
            </li>
            <li>
                <a href="/Tips">
                    <svg class="menu-icon" viewBox="0 0 24 24"><path d="M9 21h6"></path><path d="M11 21v-3.8c-1.3-.4-2-1.7-2-3.1 0-2 1.8-3.6 4-3.6s4 1.6 4 3.6c0 1.4-.7 2.7-2 3.1V21"></path><path d="M12 2A4 4 0 0 0 8 6"></path></svg>
                    Tips
                </a>
            </li>
            <li>
                <a href="/Account/Perfil">
                    <svg class="menu-icon" viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                    Perfil
                </a>
            </li>
        </ul>
        
        <div style="padding: 1rem; margin-top: auto;">
             <a asp-action="Logout" asp-controller="Account" style="display:flex; align-items:center; justify-content:center; gap:8px; padding:0.75rem; color:#ef4444; text-decoration:none; border-radius:8px; font-size:14px; font-weight:500; transition:background 0.2s;">
                 <svg class="menu-icon" viewBox="0 0 24 24" style="width:16px; height:16px;"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
                 Cerrar sesión
             </a>
        </div>
    </aside>

    <main class="main-content">
        <h1 class="header-title">¡@saludo, @(ViewBag.Nombre ?? "Usuario")! 👋</h1>
        <div class="header-date">@fechaStr</div>

        <!-- Banner de resumen -->
        <div class="summary-banner">
            <div class="summary-title">Resumen del día</div>
            <div class="summary-sub">Mantén el control de tus actividades</div>
            <div class="stats-grid">
                <div class="stat-card">
                    <div class="stat-number">0</div>
                    <div class="stat-label">Tareas pendientes</div>
                </div>
                <div class="stat-card">
                    <div class="stat-number">5</div>
                    <div class="stat-label">Eventos próximos</div>
                </div>
                <div class="stat-card">
                    <div class="stat-number">6</div>
                    <div class="stat-label">Lugares cercanos</div>
                </div>
                <div class="stat-card">
                    <div class="stat-number">6</div>
                    <div class="stat-label">Tips disponibles</div>
                </div>
            </div>
        </div>

        <!-- Accesos directos -->
        <h2 class="section-title">Accesos rápidos</h2>
        <div class="quick-access-grid">
            <a href="/Tareas" class="qa-card">
                <div class="qa-icon-wrapper tareas">
                    <svg viewBox="0 0 24 24" style="width:20px;height:20px;stroke:currentColor;stroke-width:2;fill:none;"><polyline points="9 11 12 14 22 4"></polyline><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path></svg>
                </div>
                <div class="qa-title">Tareas</div>
                <div class="qa-desc">0 pendientes</div>
                <div class="qa-arrow">&rsaquo;</div>
            </a>
            <a href="/Lugares" class="qa-card">
                <div class="qa-icon-wrapper lugares">
                    <svg viewBox="0 0 24 24" style="width:20px;height:20px;stroke:currentColor;stroke-width:2;fill:none;"><path d="M17 3v18"></path><path d="M4 15h16"></path><path d="M3 3l18 18"></path><path d="M7 8l-4 4"></path></svg>
                </div>
                <div class="qa-title">Lugares para comer</div>
                <div class="qa-desc">Encuentra opciones económicas</div>
                <div class="qa-arrow">&rsaquo;</div>
            </a>
            <a href="/Eventos" class="qa-card">
                <div class="qa-icon-wrapper eventos">
                    <svg viewBox="0 0 24 24" style="width:20px;height:20px;stroke:currentColor;stroke-width:2;fill:none;"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                </div>
                <div class="qa-title">Eventos</div>
                <div class="qa-desc">Descubre qué hay de nuevo</div>
                <div class="qa-arrow">&rsaquo;</div>
            </a>
            <a href="/Tips" class="qa-card">
                <div class="qa-icon-wrapper tips">
                    <svg viewBox="0 0 24 24" style="width:20px;height:20px;stroke:currentColor;stroke-width:2;fill:none;"><path d="M9 21h6"></path><path d="M11 21v-3.8c-1.3-.4-2-1.7-2-3.1 0-2 1.8-3.6 4-3.6s4 1.6 4 3.6c0 1.4-.7 2.7-2 3.1V21"></path><path d="M12 2A4 4 0 0 0 8 6"></path></svg>
                </div>
                <div class="qa-title">Tips de estudio</div>
                <div class="qa-desc">Mejora tu rendimiento</div>
                <div class="qa-arrow">&rsaquo;</div>
            </a>
        </div>

        <!-- Bloque ML -->
        <h2 class="section-title">🤖 Análisis inteligente</h2>
        <div style="display:grid; grid-template-columns: 1fr 2fr; gap:1.25rem; margin-bottom:2rem;">
            
            <div style="background:#fff; border:1px solid #f1f5f9; border-radius:12px; padding:1.5rem; box-shadow:0 2px 5px rgba(0,0,0,0.02);">
                <div style="font-size:13px; color:#64748b; margin-bottom:0.5rem;">Nivel de riesgo académico</div>
                <div id="riesgo-nivel" style="font-size:28px; font-weight:700; color:#1e293b;">...</div>
                <div id="riesgo-desc" style="font-size:13px; color:#64748b; margin-top:0.5rem;">Cargando análisis...</div>
            </div>

            <div style="background:#fff; border:1px solid #f1f5f9; border-radius:12px; padding:1.5rem; box-shadow:0 2px 5px rgba(0,0,0,0.02);">
                <div style="font-size:13px; color:#64748b; margin-bottom:1rem;">Tips recomendados para ti</div>
                <div id="tips-lista" style="display:flex; flex-direction:column; gap:0.75rem;">
                    <div style="color:#94a3b8; font-size:13px;">Cargando recomendaciones...</div>
                </div>
            </div>
        </div>

        <!-- Chatbot Agente IA -->
        <h2 class="section-title">💬 Asistente académico IA</h2>
        <div style="background:#fff; border:1px solid #f1f5f9; border-radius:12px; padding:1.5rem; box-shadow:0 2px 5px rgba(0,0,0,0.02); margin-bottom:2rem;">
            <div id="chat-mensajes" style="min-height:120px; max-height:200px; overflow-y:auto; margin-bottom:1rem; display:flex; flex-direction:column; gap:0.75rem;">
                <div style="font-size:13px; color:#94a3b8;">Hola! Pregúntame sobre técnicas de estudio, organización o cómo prepararte para tus exámenes 👋</div>
            </div>
            <div style="display:flex; gap:0.75rem;">
                <input id="chat-input" type="text" placeholder="Escribe tu pregunta..." 
                    style="flex:1; padding:0.75rem 1rem; border:1px solid #e2e8f0; border-radius:8px; font-size:13px; outline:none;"
                    onkeydown="if(event.key==='Enter') enviarMensaje()" />
                <button onclick="enviarMensaje()" 
                    style="background:#3b82f6; color:#fff; border:none; border-radius:8px; padding:0.75rem 1.25rem; font-size:13px; cursor:pointer;">
                    Enviar
                </button>
            </div>
        </div>

        <script>
            let nivelRiesgoActual = 'Medio';

            async function enviarMensaje() {
                const input = document.getElementById('chat-input');
                const mensajes = document.getElementById('chat-mensajes');
                const mensaje = input.value.trim();
                if (!mensaje) return;

                input.value = '';

                // Mensaje del usuario
                mensajes.innerHTML += `
                    <div style="align-self:flex-end; background:#3b82f6; color:#fff; padding:8px 14px; border-radius:12px 12px 2px 12px; font-size:13px; max-width:80%;">
                        ${mensaje}
                    </div>`;
                mensajes.scrollTop = mensajes.scrollHeight;

                // Llamar al agente
                try {
                    const res = await fetch('/api/agente/chat', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ mensaje, nivelRiesgo: nivelRiesgoActual })
                    });
                    const data = await res.json();

                    mensajes.innerHTML += `
                        <div style="align-self:flex-start; background:#f1f5f9; color:#1e293b; padding:8px 14px; border-radius:12px 12px 12px 2px; font-size:13px; max-width:80%;">
                            🤖 ${data.respuesta}
                        </div>`;
                    mensajes.scrollTop = mensajes.scrollHeight;
                } catch(e) {
                    mensajes.innerHTML += `<div style="font-size:12px; color:#ef4444;">Error al conectar con el asistente.</div>`;
                }
            }

            // Capturar el nivel de riesgo cuando carga el ML
            const _cargarMLOriginal = cargarML;
            async function cargarML() {
                await _cargarMLOriginal();
                const riesgoEl = document.getElementById('riesgo-nivel');
                if (riesgoEl) nivelRiesgoActual = riesgoEl.textContent.trim().replace(/[⚠️📊✅]/g, '').trim();
            }
        </script>

        <!-- Banner de frase -->
        <div class="quote-banner">
            <div class="quote-text">💪 "El éxito es la suma de pequeños esfuerzos repetidos día tras día"</div>
            <div class="quote-sub">¡Sigue así, vas por buen camino!</div>
        </div>
    </main>

    <script>
        const usuarioId = parseInt('@(ViewBag.UsuarioId ?? "1")');

        async function cargarML() {
            try {
                const resRiesgo = await fetch(`/api/ml/riesgo/${usuarioId}`);
                const riesgo = await resRiesgo.json();

                const colores = { "Alto": "#ef4444", "Medio": "#f97316", "Bajo": "#22c55e" };
                const emojis  = { "Alto": "⚠️", "Medio": "📊", "Bajo": "✅" };

                document.getElementById('riesgo-nivel').innerHTML =
                    `<span style="color:${colores[riesgo.nivelRiesgo]}">${emojis[riesgo.nivelRiesgo]} ${riesgo.nivelRiesgo}</span>`;
                document.getElementById('riesgo-desc').textContent = riesgo.descripcion;

                const resRec = await fetch(`/api/ml/recomendaciones/${usuarioId}`);
                const rec = await resRec.json();

                const lista = document.getElementById('tips-lista');
                lista.innerHTML = rec.recomendaciones.map(tip => `
                    <div style="display:flex; align-items:flex-start; gap:0.75rem;">
                        <span style="background:#fff7ed; color:#f97316; padding:4px 10px; border-radius:6px; font-size:11px; font-weight:600; white-space:nowrap;">${tip.categoria}</span>
                        <div>
                            <div style="font-size:13px; font-weight:600; color:#1e293b;">${tip.titulo}</div>
                            <div style="font-size:12px; color:#94a3b8; margin-top:2px;">${tip.accionRecomendada}</div>
                        </div>
                    </div>
                `).join('');

            } catch(e) {
                document.getElementById('riesgo-desc').textContent = 'No se pudo cargar el análisis.';
            }
        }

        cargarML();
    </script>

</body>
</html>