@{
    ViewData["Title"] = "Inicio";
    Layout = null;
    var nombre = ViewBag.Nombre ?? "estudiante";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>CampusGo – Inicio</title>
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: 'Segoe UI', system-ui, sans-serif;
            background: #f1f5f9;
            display: flex;
            min-height: 100vh;
        }

        /* SIDEBAR */
        .sidebar {
            width: 220px;
            background: #ffffff;
            border-right: 1px solid #e2e8f0;
            padding: 1.5rem 1rem;
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
            position: fixed;
            top: 0; left: 0; bottom: 0;
        }

        .sidebar-brand {
            margin-bottom: 1.5rem;
            padding-left: 0.5rem;
        }

        .sidebar-brand h2 {
            font-size: 20px;
            font-weight: 700;
            color: #2563eb;
        }

        .sidebar-brand p {
            font-size: 12px;
            color: #94a3b8;
        }

        .nav-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 12px;
            border-radius: 10px;
            font-size: 14px;
            color: #475569;
            cursor: pointer;
            text-decoration: none;
            transition: background 0.15s;
        }

        .nav-item:hover { background: #f1f5f9; }
        .nav-item.active { background: #2563eb; color: #ffffff; font-weight: 500; }
        .nav-item .nav-icon { font-size: 16px; width: 20px; text-align: center; }

        /* MAIN */
        .main {
            margin-left: 220px;
            padding: 2rem 2.5rem;
            flex: 1;
        }

        .greeting h1 {
            font-size: 26px;
            font-weight: 700;
            color: #0f172a;
        }

        .greeting p {
            font-size: 14px;
            color: #64748b;
            margin-top: 4px;
        }

        /* RESUMEN */
        .resumen {
            margin-top: 1.5rem;
            background: linear-gradient(135deg, #3b82f6, #06b6d4);
            border-radius: 16px;
            padding: 1.5rem;
            color: white;
        }

        .resumen h3 { font-size: 15px; font-weight: 600; }
        .resumen p { font-size: 13px; opacity: 0.85; margin-top: 2px; margin-bottom: 1rem; }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 12px;
        }

        .stat-card {
            background: rgba(255,255,255,0.2);
            border-radius: 10px;
            padding: 14px;
        }

        .stat-card .num {
            font-size: 28px;
            font-weight: 700;
        }

        .stat-card .label {
            font-size: 12px;
            opacity: 0.9;
            margin-top: 2px;
        }

        /* ACCESOS RÁPIDOS */
        .section-title {
            font-size: 16px;
            font-weight: 600;
            color: #0f172a;
            margin: 1.75rem 0 1rem;
        }

        .accesos-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 14px;
        }

        .acceso-card {
            background: #ffffff;
            border-radius: 14px;
            padding: 1.25rem;
            border: 1px solid #e2e8f0;
            cursor: pointer;
            transition: box-shadow 0.15s;
            text-decoration: none;
        }

        .acceso-card:hover { box-shadow: 0 4px 16px rgba(0,0,0,0.08); }

        .acceso-icon {
            width: 44px; height: 44px;
            border-radius: 10px;
            display: flex; align-items: center; justify-content: center;
            font-size: 20px;
            margin-bottom: 1rem;
        }

        .icon-blue { background: #dbeafe; }
        .icon-green { background: #dcfce7; }
        .icon-purple { background: #ede9fe; }
        .icon-orange { background: #ffedd5; }

        .acceso-card h4 {
            font-size: 14px;
            font-weight: 600;
            color: #0f172a;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .acceso-card p {
            font-size: 12px;
            color: #94a3b8;
            margin-top: 4px;
        }

        /* FRASE */
        .frase {
            margin-top: 1.5rem;
            background: #f0fdf4;
            border: 1px solid #bbf7d0;
            border-radius: 12px;
            padding: 1.25rem;
            text-align: center;
        }

        .frase p:first-child {
            font-size: 14px;
            color: #166534;
            font-weight: 500;
        }

        .frase p:last-child {
            font-size: 13px;
            color: #4ade80;
            margin-top: 4px;
        }

        @@media (max-width: 768px) {
            .sidebar { display: none; }
            .main { margin-left: 0; padding: 1.25rem; }
            .stats-grid, .accesos-grid { grid-template-columns: repeat(2, 1fr); }
        }
    </style>
</head>
<body>

<!-- SIDEBAR -->
<div class="sidebar">
    <div class="sidebar-brand">
        <h2>CampusGo</h2>
        <p>Tu plataforma estudiantil</p>
    </div>
    <a class="nav-item active" href="/Account/Dashboard">
        <span class="nav-icon">🏠</span> Inicio
    </a>
    <a class="nav-item" href="/Tareas">
        <span class="nav-icon">✅</span> Tareas
    </a>
    <a class="nav-item" href="/Lugares">
        <span class="nav-icon">🍕</span> Lugares
    </a>
    <a class="nav-item" href="/Eventos">
        <span class="nav-icon">📅</span> Eventos
    </a>
    <a class="nav-item" href="/Tips">
        <span class="nav-icon">💡</span> Tips
    </a>
    <a class="nav-item" href="/Account/Perfil">
        <span class="nav-icon">👤</span> Perfil
    </a>
</div>

<!-- MAIN -->
<div class="main">

    <div class="greeting">
        <h1 id="saludo"></h1>
        <p id="fecha"></p>
    </div>

    <div class="resumen">
        <h3>Resumen del día</h3>
        <p>Mantén el control de tus actividades</p>
        <div class="stats-grid">
            <div class="stat-card">
                <div class="num">0</div>
                <div class="label">Tareas pendientes</div>
            </div>
            <div class="stat-card">
                <div class="num">5</div>
                <div class="label">Eventos próximos</div>
            </div>
            <div class="stat-card">
                <div class="num">6</div>
                <div class="label">Lugares cercanos</div>
            </div>
            <div class="stat-card">
                <div class="num">6</div>
                <div class="label">Tips disponibles</div>
            </div>
        </div>
    </div>

    <div class="section-title">Accesos rápidos</div>
    <div class="accesos-grid">
        <a class="acceso-card" href="/Tareas">
            <div class="acceso-icon icon-blue">✅</div>
            <h4>Tareas <span>›</span></h4>
            <p>0 pendientes</p>
        </a>
        <a class="acceso-card" href="/Lugares">
            <div class="acceso-icon icon-green">🍕</div>
            <h4>Lugares para comer <span>›</span></h4>
            <p>Encuentra opciones económicas</p>
        </a>
        <a class="acceso-card" href="/Eventos">
            <div class="acceso-icon icon-purple">📅</div>
            <h4>Eventos <span>›</span></h4>
            <p>Descubre qué hay de nuevo</p>
        </a>
        <a class="acceso-card" href="/Tips">
            <div class="acceso-icon icon-orange">💡</div>
            <h4>Tips de estudio <span>›</span></h4>
            <p>Mejora tu rendimiento</p>
        </a>
    </div>

    <div class="frase">
        <p>💪 "El éxito es la suma de pequeños esfuerzos repetidos día tras día"</p>
        <p>¡Sigue así, vas por buen camino!</p>
    </div>

</div>

<script>
    // Saludo según la hora
    const hora = new Date().getHours();
    let saludo = hora < 12 ? "¡Buenos días" : hora < 19 ? "¡Buenas tardes" : "¡Buenas noches";
    const nombre = "@nombre";
    document.getElementById("saludo").innerHTML = saludo + ", " + nombre + "! 👋";

    // Fecha actual
    const fecha = new Date().toLocaleDateString("es-PE", {
        weekday: "long", year: "numeric", month: "long", day: "numeric"
    });
    document.getElementById("fecha").textContent = fecha.charAt(0).toUpperCase() + fecha.slice(1);
</script>

</body>
</html>
