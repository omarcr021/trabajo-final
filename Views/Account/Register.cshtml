@{
    ViewData["Title"] = "Registro";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>CampusGo – Crear cuenta</title>
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: 'Segoe UI', system-ui, sans-serif;
            min-height: 100vh;
            background: linear-gradient(135deg, #dbeafe 0%, #e0f2fe 50%, #dde9f7 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem;
        }

        .container {
            display: flex;
            gap: 3rem;
            align-items: center;
            width: 100%;
            max-width: 860px;
        }

        .left {
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 1rem;
        }

        .logo-circle {
            width: 120px;
            height: 120px;
            border-radius: 50%;
            background: #c7d9f0;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .logo-circle svg { width: 60px; height: 60px; }

        .brand-name {
            font-size: 32px;
            font-weight: 700;
            color: #2563eb;
        }

        .brand-sub {
            font-size: 14px;
            color: #64748b;
            text-align: center;
            max-width: 220px;
            line-height: 1.6;
        }

        .feature-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
            margin-top: 0.5rem;
            width: 220px;
        }

        .feature-card {
            background: #ffffff;
            border-radius: 14px;
            padding: 16px 12px;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 6px;
            font-size: 13px;
            color: #475569;
            border: 1px solid rgba(148,163,184,0.25);
        }

        .feature-card .icon { font-size: 22px; }

        .card {
            flex: 1.3;
            background: #ffffff;
            border-radius: 18px;
            padding: 2.5rem 2.75rem;
            border: 1px solid rgba(148,163,184,0.2);
        }

        .card h1 {
            font-size: 24px;
            font-weight: 700;
            color: #0f172a;
            margin-bottom: 4px;
        }

        .card .subtitle {
            font-size: 14px;
            color: #64748b;
            margin-bottom: 1.75rem;
        }

        .field { margin-bottom: 1rem; }

        .field label {
            display: block;
            font-size: 14px;
            font-weight: 500;
            color: #374151;
            margin-bottom: 6px;
        }

        .field input {
            width: 100%;
            padding: 11px 14px;
            font-size: 14px;
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            color: #0f172a;
            outline: none;
            transition: border-color 0.15s, background 0.15s;
        }

        .field input::placeholder { color: #94a3b8; }

        .field input:focus {
            border-color: #3b82f6;
            background: #ffffff;
            box-shadow: 0 0 0 3px rgba(59,130,246,0.12);
        }

        .btn-register {
            width: 100%;
            padding: 12px;
            margin-top: 0.6rem;
            margin-bottom: 1.25rem;
            background: #2563eb;
            color: #ffffff;
            font-size: 15px;
            font-weight: 600;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            transition: background 0.15s;
        }

        .btn-register:hover { background: #1d4ed8; }

        .login-line {
            font-size: 14px;
            color: #64748b;
            text-align: center;
        }

        .login-line a {
            color: #2563eb;
            font-weight: 600;
            text-decoration: none;
        }

        .login-line a:hover { text-decoration: underline; }

        @@media (max-width: 640px) {
            .container { flex-direction: column; gap: 2rem; }
            .card { padding: 1.75rem; }
        }
    </style>
</head>
<body>

<div class="container">

    <div class="left">
        <div class="logo-circle">
            <svg viewBox="0 0 56 56" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M28 10L6 22l22 12 22-12L28 10z" fill="#2563eb"/>
                <path d="M6 22v12c0 0 8 10 22 10s22-10 22-10V22"
                      stroke="#2563eb" stroke-width="2.5" fill="none" stroke-linecap="round"/>
                <rect x="44" y="22" width="3.5" height="12" rx="1.75" fill="#2563eb"/>
                <polygon points="45.75,36 42,43 49.5,43" fill="#2563eb"/>
            </svg>
        </div>
        <span class="brand-name">CampusGo</span>
        <p class="brand-sub">Tu plataforma todo-en-uno para una mejor experiencia universitaria</p>
        <div class="feature-grid">
            <div class="feature-card"><span class="icon">📚</span> Tareas</div>
            <div class="feature-card"><span class="icon">🍕</span> Lugares</div>
            <div class="feature-card"><span class="icon">🎉</span> Eventos</div>
            <div class="feature-card"><span class="icon">💡</span> Tips</div>
        </div>
    </div>

    <div class="card">
        <h1>¡Únete a CampusGo!</h1>
        <p class="subtitle">Crea tu cuenta y organiza tu vida universitaria</p>

        @if (!ViewData.ModelState.IsValid)
        {
            <div style="background: #fee2e2; border: 1px solid #f87171; color: #b91c1c; padding: 10px; border-radius: 8px; margin-bottom: 15px; font-size: 14px;">
                @foreach(var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <p>@error.ErrorMessage</p>
                }
            </div>
        }

        <form method="post" asp-action="Register" asp-controller="Account">
            <div class="field">
                <label for="nombre">Nombre completo</label>
                <input type="text" id="nombre" name="nombre"
                       placeholder="Juan Pérez" />
            </div>
            <div class="field">
                <label for="carrera">Carrera</label>
                <input type="text" id="carrera" name="carrera"
                       placeholder="Ej: Ingeniería en Software" />
            </div>
            <div class="field">
                <label for="email">Correo electrónico</label>
                <input type="email" id="email" name="email"
                       placeholder="estudiante@universidad.edu"
                       autocomplete="email" />
            </div>
            <div class="field">
                <label for="password">Contraseña</label>
                <input type="password" id="password" name="password"
                       placeholder="••••••••"
                       autocomplete="new-password" />
            </div>
            <button class="btn-register" type="submit">Crear cuenta</button>
        </form>

        <p class="login-line">
            ¿Ya tienes cuenta? <a asp-action="Login" asp-controller="Account">Inicia sesión</a>
        </p>
    </div>

</div>

</body>
</html>