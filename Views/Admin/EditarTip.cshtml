@model trabfinal.Models.TipEstudio
@{
    ViewData["Title"] = "Formulario de Tip de Estudio";
    bool isEdit = Model?.Id > 0;
}

<div class="container mt-4">
    <div class="card shadow-sm max-w-lg mx-auto" style="max-width: 600px;">
        <div class="card-header bg-white">
            <h3 class="card-title my-2">@(isEdit ? "Editar Tip de Estudio" : "Crear Nuevo Tip")</h3>
        </div>
        <div class="card-body">
            <form asp-action="@(isEdit ? "EditarTip" : "CrearTip")" method="post">
                @if (isEdit) { <input type="hidden" asp-for="Id" /> }
                
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Titulo" class="form-label fw-bold">Título</label>
                    <input asp-for="Titulo" class="form-control" placeholder="Ej. Estudia en bloques de 50 minutos" required />
                    <span asp-validation-for="Titulo" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Categoria" class="form-label fw-bold">Categoría</label>
                    <select asp-for="Categoria" class="form-select" required>
                        <option value="">Selecciona una categoría...</option>
                        <option value="Organización">Organización</option>
                        <option value="Concentración">Concentración</option>
                        <option value="Memoria">Memoria</option>
                        <option value="Motivación">Motivación</option>
                        <option value="Lectura">Lectura</option>
                        <option value="Repaso">Repaso</option>
                        <option value="Bienestar">Bienestar</option>
                        <option value="Enfoque">Enfoque</option>
                        <option value="Comprension">Comprensión</option>
                        <option value="Planificacion">Planificación</option>
                    </select>
                    <span asp-validation-for="Categoria" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Descripcion" class="form-label fw-bold">Descripción Corta</label>
                    <textarea asp-for="Descripcion" class="form-control" rows="2" placeholder="Explica brevemente el beneficio..." required></textarea>
                    <span asp-validation-for="Descripcion" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="AccionRecomendada" class="form-label fw-bold">Acción Recomendada</label>
                    <textarea asp-for="AccionRecomendada" class="form-control" rows="2" placeholder="Haz esto: ..." required></textarea>
                    <span asp-validation-for="AccionRecomendada" class="text-danger"></span>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4">
                    <a asp-action="Tips" class="btn btn-light border">Cancelar</a>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-save"></i> @(isEdit ? "Guardar Cambios" : "Crear Tip")
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>