@{
    ViewData["Title"] = "Dashboard";
}

<div class="mb-4">
    <h2 class="page-title">Dashboard</h2>
    <p class="page-subtitle">Resumen general de CampusGo</p>
</div>

<!-- Stats Cards -->
<div class="row mb-4">
    <div class="col-md-3 col-sm-6 mb-3">
        <div class="card h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="stat-title">Total Usuarios</div>
                        <div class="stat-value">@ViewBag.TotalUsuarios</div>
                        <span class="stat-subtitle">@ViewBag.TotalUsuarios activos</span>
                    </div>
                    <div class="stat-icon icon-blue">
                        <i class="bi bi-people"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <div class="col-md-3 col-sm-6 mb-3">
        <div class="card h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="stat-title">Eventos</div>
                        <div class="stat-value">@ViewBag.TotalEventos</div>
                        <span class="stat-subtitle">Próximos eventos</span>
                    </div>
                    <div class="stat-icon icon-green">
                        <i class="bi bi-calendar-event"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <div class="col-md-3 col-sm-6 mb-3">
        <div class="card h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="stat-title">Lugares</div>
                        <div class="stat-value">@ViewBag.TotalLugares</div>
                        <span class="stat-subtitle">Campus y alrededores</span>
                    </div>
                    <div class="stat-icon icon-orange">
                        <i class="bi bi-geo-alt"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <div class="col-md-3 col-sm-6 mb-3">
        <div class="card h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="stat-title">Tips de Estudio</div>
                        <div class="stat-value">@ViewBag.TotalTips</div>
                        <span class="stat-subtitle">Recomendaciones ML</span>
                    </div>
                    <div class="stat-icon icon-purple">
                        <i class="bi bi-lightbulb"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Charts Row -->
<div class="row mb-4">
    <!-- Line Chart: Actividad mensual -->
    <div class="col-lg-8 mb-3">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h6 class="mb-0 fw-bold">Actividad mensual</h6>
            </div>
            <div class="card-body">
                <div style="height: 300px;">
                    <canvas id="chartActividad"></canvas>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Doughnut Chart: Distribución -->
    <div class="col-lg-4 mb-3">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h6 class="mb-0 fw-bold">Distribución de Carreras</h6>
            </div>
            <div class="card-body d-flex align-items-center justify-content-center">
                <div style="height: 250px; width: 100%;">
                    <canvas id="chartCarreras"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        fetch('/Admin/ChartData')
            .then(response => response.json())
            .then(data => {
                // Line Chart: Actividad Mensual (Styled like the image)
                const ctxLine = document.getElementById('chartActividad').getContext('2d');
                
                // Create gradient for the line chart fill
                let gradientBlue = ctxLine.createLinearGradient(0, 0, 0, 400);
                gradientBlue.addColorStop(0, 'rgba(59, 130, 246, 0.2)');
                gradientBlue.addColorStop(1, 'rgba(59, 130, 246, 0)');
                
                new Chart(ctxLine, {
                    type: 'line',
                    data: {
                        labels: data.usuariosPorMes.map(d => d.mes),
                        datasets: [{
                            label: 'Nuevos Usuarios',
                            data: data.usuariosPorMes.map(d => d.cantidad),
                            borderColor: '#3b82f6',
                            backgroundColor: gradientBlue,
                            borderWidth: 2,
                            pointBackgroundColor: '#fff',
                            pointBorderColor: '#3b82f6',
                            pointBorderWidth: 2,
                            pointRadius: 4,
                            pointHoverRadius: 6,
                            fill: true,
                            tension: 0.4
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                position: 'bottom',
                                labels: {
                                    usePointStyle: true,
                                    padding: 20,
                                    font: { family: "'Nunito', sans-serif", size: 12 }
                                }
                            }
                        },
                        scales: {
                            y: {
                                beginAtZero: true,
                                border: { display: false },
                                grid: {
                                    color: '#f0f0f0',
                                    drawBorder: false,
                                },
                                ticks: {
                                    stepSize: 1,
                                    color: '#adb5bd',
                                    font: { family: "'Nunito', sans-serif" }
                                }
                            },
                            x: {
                                grid: { display: false },
                                ticks: {
                                    color: '#adb5bd',
                                    font: { family: "'Nunito', sans-serif" }
                                }
                            }
                        }
                    }
                });

                // Doughnut Chart: Distribución de Carreras
                const ctxDoughnut = document.getElementById('chartCarreras').getContext('2d');
                const coloresPastel = [
                    '#f59e0b', '#10b981', '#3b82f6', '#ef4444', '#8b5cf6',
                    '#14b8a6', '#64748b', '#f43f5e', '#84cc16', '#06b6d4'
                ];
                
                new Chart(ctxDoughnut, {
                    type: 'doughnut',
                    data: {
                        labels: data.distribucionCarreras.map(d => d.carrera),
                        datasets: [{
                            data: data.distribucionCarreras.map(d => d.cantidad),
                            backgroundColor: coloresPastel.slice(0, data.distribucionCarreras.length),
                            borderWidth: 0,
                            hoverOffset: 4
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        cutout: '70%',
                        plugins: {
                            legend: {
                                position: 'bottom',
                                labels: {
                                    usePointStyle: true,
                                    padding: 20,
                                    font: { family: "'Nunito', sans-serif", size: 12 }
                                }
                            }
                        }
                    }
                });
            })
            .catch(err => console.error('Error cargando gráficos:', err));
    </script>
}