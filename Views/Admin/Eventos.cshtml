@model IEnumerable<trabfinal.Models.Evento>
@{
    ViewData["Title"] = "Gestión de Eventos";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-calendar-event-fill text-success"></i> Gestión de Eventos</h2>
        <div>
            <a asp-action="CrearEvento" class="btn btn-success"><i class="bi bi-plus-lg"></i> Nuevo Evento</a>
            <a asp-action="Index" class="btn btn-secondary">Volver al Dashboard</a>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th class="ps-4">Título</th>
                            <th>Categoría</th>
                            <th>Fecha Inicio</th>
                            <th>Ubicación</th>
                            <th>Estado</th>
                            <th class="text-center pe-4">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr><td colspan="6" class="text-center py-4">No hay eventos registrados.</td></tr>
                        }
                        @foreach (var e in Model)
                        {
                            <tr class="@(!e.Activo ? "table-secondary" : "")">
                                <td class="ps-4 fw-bold">@e.Titulo</td>
                                <td><span class="badge bg-info">@e.Categoria</span></td>
                                <td>@e.FechaInicio.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>@e.Ubicacion</td>
                                <td>
                                    <form asp-action="ToggleEventoActivo" asp-route-id="@e.Id" method="post" style="display:inline;">
                                        <button type="submit" class="btn btn-sm @(e.Activo ? "btn-success" : "btn-outline-secondary")" title="@(e.Activo ? "Desactivar" : "Activar")">
                                            <i class="bi @(e.Activo ? "bi-eye-fill" : "bi-eye-slash")"></i> @(e.Activo ? "Activo" : "Inactivo")
                                        </button>
                                    </form>
                                </td>
                                <td class="text-center pe-4">
                                    <div class="btn-group" role="group">
                                        <a asp-action="EditarEvento" asp-route-id="@e.Id" class="btn btn-sm btn-outline-primary" title="Editar">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <form asp-action="EliminarEvento" asp-route-id="@e.Id" method="post" style="display:inline-block;" onsubmit="return confirm('¿Eliminar este evento permanentemente?');">
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Eliminar">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
