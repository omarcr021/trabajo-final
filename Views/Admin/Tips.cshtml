@model IEnumerable<trabfinal.Models.TipEstudio>
@{
    ViewData["Title"] = "Gestión de Tips de Estudio";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-lightbulb-fill text-warning"></i> Gestión de Tips de Estudio</h2>
        <div>
            <a asp-action="CrearTip" class="btn btn-success"><i class="bi bi-plus-lg"></i> Nuevo Tip</a>
            <a asp-action="Index" class="btn btn-secondary">Volver al Dashboard</a>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th class="ps-4">Categoría</th>
                            <th>Título</th>
                            <th>Descripción</th>
                            <th>Acción Recomendada</th>
                            <th class="text-center pe-4">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr><td colspan="5" class="text-center py-4">No hay tips registrados en la base de datos.</td></tr>
                        }
                        @foreach (var tip in Model)
                        {
                            <tr>
                                <td class="ps-4"><span class="badge bg-secondary">@tip.Categoria</span></td>
                                <td class="fw-bold">@tip.Titulo</td>
                                <td><small class="text-muted">@tip.Descripcion</small></td>
                                <td>@tip.AccionRecomendada</td>
                                <td class="text-center pe-4">
                                    <div class="btn-group" role="group">
                                        <a asp-action="EditarTip" asp-route-id="@tip.Id" class="btn btn-sm btn-outline-primary" title="Editar">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <form asp-action="EliminarTip" asp-route-id="@tip.Id" method="post" style="display:inline-block;" onsubmit="return confirm('¿Está seguro de eliminar este tip? Afectará a las recomendaciones.');">
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Eliminar">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>