@using System.Globalization
@using System.Linq
@model trabfinal.Models.Evento
@{
    ViewData["Title"] = "Detalle del evento";
    Layout = null;

    var cultura = new CultureInfo("es-PE");
    var eventosSimilares = ViewBag.EventosSimilares as IEnumerable<trabfinal.Models.Evento> ?? Enumerable.Empty<trabfinal.Models.Evento>();
    var estaRegistrado = ViewBag.EstaRegistrado as bool? ?? false;
    var categoriaNormalizada = (Model?.Categoria ?? string.Empty).Trim().ToLowerInvariant();
    string mostrarCategoria = categoriaNormalizada switch
    {
        "academico" => "Académico",
        "social" => "Social",
        "deportivo" => "Deportivo",
        "administrativo" => "Administrativo",
        _ => Model?.Categoria ?? "General"
    };
    var categoriaClase = categoriaNormalizada switch
    {
        "academico" => "category-academico",
        "social" => "category-social",
        "deportivo" => "category-deportivo",
        "administrativo" => "category-administrativo",
        _ => "category-default"
    };
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>CampusGo - Detalle del evento</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        :root {
            --primary: #3b82f6;
            --primary-dark: #2563eb;
            --sidebar-width: 250px;
            --text-main: #1e293b;
            --text-soft: #64748b;
            --line: #f1f5f9;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: "Segoe UI", system-ui, sans-serif;
        }

        body {
            display: flex;
            min-height: 100vh;
            background-color: #ffffff;
            color: #333;
        }

        .sidebar {
            width: var(--sidebar-width);
            border-right: 1px solid var(--line);
            display: flex;
            flex-direction: column;
            padding: 2rem 0;
        }

        .sidebar-header {
            padding: 0 1.5rem 1.5rem 1.5rem;
            border-bottom: 1px solid var(--line);
        }

        .brand-name {
            font-size: 22px;
            font-weight: 700;
            color: var(--primary-dark);
        }

        .brand-sub {
            font-size: 13px;
            color: #64748b;
            margin-top: 4px;
        }

        .sidebar-menu {
            list-style: none;
            padding: 1.5rem 1rem;
            flex: 1;
        }

        .sidebar-menu li {
            margin-bottom: 0.25rem;
        }

        .sidebar-menu a {
            display: flex;
            align-items: center;
            padding: 0.85rem 1rem;
            color: #64748b;
            text-decoration: none;
            border-radius: 8px;
            font-size: 14px;
            transition: all 0.2s;
            gap: 12px;
        }

        .sidebar-menu a:hover:not(.active) {
            background-color: #f8fafc;
            color: #334155;
        }

        .sidebar-menu a.active {
            background-color: var(--primary);
            color: #fff;
        }

        .menu-icon {
            width: 18px;
            height: 18px;
            stroke: currentColor;
            stroke-width: 2;
            fill: none;
        }

        .main-content {
            flex: 1;
            padding: 2.5rem 3rem;
            overflow-y: auto;
        }

        .back-link {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            color: #64748b;
            text-decoration: none;
            font-size: 14px;
            font-weight: 600;
            margin-bottom: 1.5rem;
        }

        .back-link:hover {
            color: #334155;
        }

        .details-card,
        .similar-card {
            background: #fff;
            border: 1px solid var(--line);
            border-radius: 12px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.02);
        }

        .details-card {
            overflow: hidden;
        }

        .details-banner {
            background: linear-gradient(90deg, #1890ff, #00b4d8);
            color: #fff;
            padding: 1.75rem 2rem;
        }

        .category-badge {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 0.35rem 0.8rem;
            border-radius: 999px;
            font-size: 11px;
            font-weight: 700;
            background: rgba(255,255,255,0.2);
            margin-bottom: 0.9rem;
        }

        .details-title {
            font-size: 30px;
            font-weight: 700;
            margin-bottom: 0.5rem;
        }

        .details-subcopy {
            font-size: 14px;
            opacity: 0.95;
            max-width: 720px;
        }

        .details-body {
            padding: 1.75rem 2rem 2rem;
        }

        .info-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 1rem;
            margin-bottom: 1.5rem;
        }

        .info-card {
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 12px;
            padding: 1rem;
        }

        .info-label {
            font-size: 12px;
            color: #94a3b8;
            margin-bottom: 0.35rem;
        }

        .info-value {
            font-size: 14px;
            line-height: 1.5;
            color: var(--text-main);
            font-weight: 600;
        }

        .description-card {
            background: #fff;
            border: 1px solid var(--line);
            border-radius: 12px;
            padding: 1.25rem;
        }

        .description-card h3,
        .similar-section h3 {
            font-size: 16px;
            font-weight: 700;
            color: var(--text-main);
            margin-bottom: 0.75rem;
        }

        .description-card p {
            font-size: 14px;
            line-height: 1.7;
            color: var(--text-soft);
            margin: 0;
        }

        .inline-badge {
            display: inline-flex;
            padding: 0.3rem 0.75rem;
            border-radius: 999px;
            font-size: 11px;
            font-weight: 700;
            margin-bottom: 0.85rem;
        }

        .category-academico { background: #dbeafe; color: #1d4ed8; }
        .category-social { background: #fce7f3; color: #be185d; }
        .category-deportivo { background: #dcfce7; color: #15803d; }
        .category-administrativo { background: #fef3c7; color: #a16207; }
        .category-default { background: #e2e8f0; color: #334155; }

        .actions-row {
            display: flex;
            gap: 0.75rem;
            flex-wrap: wrap;
            margin-top: 1.5rem;
        }

        .actions-row .btn {
            border-radius: 10px;
            font-size: 14px;
            font-weight: 600;
            padding: 0.75rem 1.1rem;
        }

        .similar-section {
            margin-top: 2rem;
        }

        .similar-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 1rem;
            margin-top: 1rem;
        }

        .similar-card {
            padding: 1.2rem;
            transition: transform 0.2s, box-shadow 0.2s;
        }

        .similar-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 12px -3px rgba(0,0,0,0.05);
        }

        .similar-card h4 {
            font-size: 15px;
            color: var(--text-main);
            font-weight: 700;
            margin-bottom: 0.5rem;
        }

        .similar-card p {
            font-size: 13px;
            color: var(--text-soft);
            line-height: 1.6;
            margin-bottom: 0.9rem;
        }

        @@media (max-width: 900px) {
            body { flex-direction: column; }
            .sidebar { width: 100%; }
            .main-content { padding: 1.5rem; }
            .info-grid,
            .similar-grid { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body>
    <aside class="sidebar">
        <div class="sidebar-header">
            <div class="brand-name">CampusGo</div>
            <div class="brand-sub">Tu plataforma estudiantil</div>
        </div>
        <ul class="sidebar-menu">
            <li>
                <a href="/Account/Dashboard">
                    <svg class="menu-icon" viewBox="0 0 24 24"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
                    Inicio
                </a>
            </li>
            <li>
                <a href="/Tareas">
                    <svg class="menu-icon" viewBox="0 0 24 24"><polyline points="9 11 12 14 22 4"></polyline><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path></svg>
                    Tareas
                </a>
            </li>
            <li>
                <a href="/Lugares">
                    <svg class="menu-icon" viewBox="0 0 24 24"><path d="M17 3v18"></path><path d="M4 15h16"></path><path d="M3 3l18 18"></path><path d="M7 8l-4 4"></path></svg>
                    Lugares
                </a>
            </li>
            <li>
                <a href="/Eventos" class="active">
                    <svg class="menu-icon" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                    Eventos
                </a>
            </li>
            <li>
                <a href="/Tips">
                    <svg class="menu-icon" viewBox="0 0 24 24"><path d="M9 21h6"></path><path d="M11 21v-3.8c-1.3-.4-2-1.7-2-3.1 0-2 1.8-3.6 4-3.6s4 1.6 4 3.6c0 1.4-.7 2.7-2 3.1V21"></path><path d="M12 2A4 4 0 0 0 8 6"></path></svg>
                    Tips
                </a>
            </li>
            <li>
                <a href="/Account/Perfil">
                    <svg class="menu-icon" viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                    Perfil
                </a>
            </li>
        </ul>
    </aside>

    <main class="main-content">
        <a href="/Eventos" class="back-link">Volver a eventos</a>

        <section class="details-card">
            <div class="details-banner">
                <span class="category-badge">@mostrarCategoria</span>
                <h1 class="details-title">@Model!.Titulo</h1>
                <p class="details-subcopy">Consulta toda la información del evento dentro del mismo lenguaje visual del dashboard principal.</p>
            </div>

            <div class="details-body">
                <div class="info-grid">
                    <div class="info-card">
                        <div class="info-label">Inicio</div>
                        <div class="info-value">@Model!.FechaInicio.ToString("dddd, dd MMMM yyyy - hh:mm tt", cultura)</div>
                    </div>
                    <div class="info-card">
                        <div class="info-label">Fin</div>
                        <div class="info-value">@Model!.FechaFin.ToString("dddd, dd MMMM yyyy - hh:mm tt", cultura)</div>
                    </div>
                    <div class="info-card">
                        <div class="info-label">Ubicación</div>
                        <div class="info-value">@Model!.Ubicacion</div>
                    </div>
                </div>

                <div class="description-card">
                    <span class="inline-badge @categoriaClase">@mostrarCategoria</span>
                    <h3>Descripción completa</h3>
                    <p>@Model!.Descripcion</p>
                </div>

                <div class="actions-row">
                    @if (estaRegistrado)
                    {
                        <button type="button" class="btn btn-success" disabled>Registrado</button>
                    }
                    else
                    {
                        <form asp-action="Registrar" asp-route-id="@Model!.Id" method="post">
                            <button type="submit" class="btn btn-primary">Asistir al evento</button>
                        </form>
                    }
                    <a href="/Eventos" class="btn btn-outline-secondary">Explorar más eventos</a>
                </div>
            </div>
        </section>

        <section class="similar-section">
            <h3>Eventos similares</h3>

            @if (eventosSimilares.Any())
            {
                <div class="similar-grid">
                    @foreach (var evento in eventosSimilares)
                    {
                        var similarCategoria = (evento.Categoria ?? string.Empty).Trim().ToLowerInvariant();
                        var similarTexto = similarCategoria switch
                        {
                            "academico" => "Académico",
                            "social" => "Social",
                            "deportivo" => "Deportivo",
                            "administrativo" => "Administrativo",
                            _ => evento.Categoria ?? "General"
                        };
                        var similarClase = similarCategoria switch
                        {
                            "academico" => "category-academico",
                            "social" => "category-social",
                            "deportivo" => "category-deportivo",
                            "administrativo" => "category-administrativo",
                            _ => "category-default"
                        };

                        <article class="similar-card">
                            <span class="inline-badge @similarClase">@similarTexto</span>
                            <h4>@evento.Titulo</h4>
                            <p>@evento.Descripcion</p>
                            <div class="small text-muted mb-3">@evento.FechaInicio.ToString("dd MMM yyyy", cultura) | @evento.Ubicacion</div>
                            <a asp-action="Details" asp-route-id="@evento.Id" class="btn btn-outline-secondary w-100">Ver detalles</a>
                        </article>
                    }
                </div>
            }
            else
            {
                <div class="similar-card mt-3">
                    <h4 class="mb-2">Aún no hay eventos similares cargados</h4>
                    <p class="mb-0">Esta sección ya está lista para mostrar recomendaciones relacionadas.</p>
                </div>
            }
        </section>
    </main>
</body>
</html>
