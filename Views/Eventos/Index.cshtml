@using System.Globalization
@model IEnumerable<trabfinal.Models.Evento>
@{
    ViewData["Title"] = "Eventos";
    Layout = null;

    var eventos = Model?.ToList() ?? new List<trabfinal.Models.Evento>();
    var cultura = new CultureInfo("es-PE");
    var eventosInscritos = ViewBag.EventosInscritos as List<int> ?? new List<int>();

    string MostrarCategoria(string? categoria) => (categoria ?? string.Empty).Trim().ToLowerInvariant() switch
    {
        "conciertos" => "Conciertos",
        "deportes" => "Deportes",
        "teatros" => "Teatros",
        "entretenimiento" => "Entretenimiento",
        "culturales" => "Culturales",
        "circos e infantiles" => "Circos e Infantiles",
        _ => categoria ?? "Entretenimiento"
    };
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>CampusGo - Eventos</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        :root {
            --primary: #3b82f6;
            --primary-dark: #2563eb;
            --sidebar-width: 250px;
            --text-main: #1e293b;
            --text-soft: #64748b;
            --line: #f1f5f9;
            --panel-shadow: 0 8px 12px -3px rgba(0,0,0,0.05);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: "Segoe UI", system-ui, sans-serif;
        }

        body {
            display: flex;
            min-height: 100vh;
            background-color: #ffffff;
            color: #333;
        }

        .sidebar {
            width: var(--sidebar-width);
            border-right: 1px solid var(--line);
            display: flex;
            flex-direction: column;
            padding: 2rem 0;
        }

        .sidebar-header {
            padding: 0 1.5rem 1.5rem 1.5rem;
            border-bottom: 1px solid var(--line);
        }

        .brand-name {
            font-size: 22px;
            font-weight: 700;
            color: var(--primary-dark);
        }

        .brand-sub {
            font-size: 13px;
            color: #64748b;
            margin-top: 4px;
        }

        .sidebar-menu {
            list-style: none;
            padding: 1.5rem 1rem;
            flex: 1;
        }

        .sidebar-menu li {
            margin-bottom: 0.25rem;
        }

        .sidebar-menu a {
            display: flex;
            align-items: center;
            padding: 0.85rem 1rem;
            color: #64748b;
            text-decoration: none;
            border-radius: 8px;
            font-size: 14px;
            transition: all 0.2s;
            gap: 12px;
        }

        .sidebar-menu a:hover:not(.active) {
            background-color: #f8fafc;
            color: #334155;
        }

        .sidebar-menu a.active {
            background-color: var(--primary);
            color: #fff;
        }

        .menu-icon {
            width: 18px;
            height: 18px;
            stroke: currentColor;
            stroke-width: 2;
            fill: none;
        }

        .main-content {
            flex: 1;
            padding: 2.5rem 3rem;
            overflow-y: auto;
            background: #ffffff;
        }

        .header-title {
            font-size: 32px;
            font-weight: 700;
            color: var(--text-main);
        }

        .header-date {
            color: #94a3b8;
            margin-top: 8px;
            font-size: 13px;
        }

        .summary-banner {
            background: linear-gradient(90deg, #1890ff, #00b4d8);
            border-radius: 12px;
            padding: 1.5rem 2rem;
            color: #fff;
            margin-top: 2rem;
            box-shadow: 0 4px 14px rgba(0, 180, 216, 0.2);
        }

        .summary-title {
            font-size: 16px;
            font-weight: 600;
        }

        .summary-sub {
            font-size: 13px;
            opacity: 0.9;
            margin-top: 4px;
            margin-bottom: 1.5rem;
        }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 1rem;
        }

        .stat-card {
            background: rgba(255, 255, 255, 0.15);
            padding: 1.25rem 1rem;
            border-radius: 8px;
        }

        .stat-number {
            font-size: 26px;
            font-weight: 700;
            line-height: 1;
        }

        .stat-label {
            font-size: 12px;
            opacity: 0.9;
            margin-top: 8px;
        }

        .section-title {
            font-size: 16px;
            font-weight: 700;
            margin: 2rem 0 1rem 0;
            color: var(--text-main);
        }

        .filters-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 1rem;
            flex-wrap: wrap;
            background: #fff;
            border: 1px solid var(--line);
            border-radius: 12px;
            padding: 1rem 1.25rem;
            box-shadow: 0 2px 5px rgba(0,0,0,0.02);
        }

        .chip-group {
            display: flex;
            flex-wrap: wrap;
            gap: 0.65rem;
        }

        .filter-chip {
            border: 1px solid #e2e8f0;
            background: #fff;
            color: #64748b;
            border-radius: 999px;
            padding: 0.6rem 1rem;
            font-size: 13px;
            font-weight: 600;
            transition: all 0.2s;
        }

        .filter-chip:hover,
        .filter-chip.active {
            background: var(--primary);
            color: #fff;
            border-color: var(--primary);
        }

        .time-select {
            min-width: 180px;
            border-radius: 10px;
            border: 1px solid #e2e8f0;
            font-size: 14px;
            color: #475569;
        }

        .results-copy {
            margin-top: 1rem;
            font-size: 13px;
            color: #94a3b8;
        }

        .event-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 1.25rem;
            margin-top: 1.5rem;
        }

        .event-card {
            background: #fff;
            border: 1px solid var(--line);
            border-radius: 12px;
            padding: 1.25rem;
            display: flex;
            flex-direction: column;
            gap: 1rem;
            transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s;
            box-shadow: 0 2px 5px rgba(0,0,0,0.02);
        }

        .event-card:hover {
            transform: translateY(-2px);
            box-shadow: var(--panel-shadow);
            border-color: #e2e8f0;
        }

        .event-card-top {
            display: flex;
            justify-content: space-between;
            gap: 0.75rem;
            align-items: flex-start;
        }

        .event-card h3 {
            font-size: 16px;
            font-weight: 700;
            color: var(--text-main);
            margin: 0;
        }

        .category-badge {
            padding: 0.35rem 0.7rem;
            border-radius: 999px;
            font-size: 11px;
            font-weight: 700;
            white-space: nowrap;
        }

        .category-conciertos { background: #dbeafe; color: #1d4ed8; }
        .category-deportes { background: #dcfce7; color: #15803d; }
        .category-teatros { background: #fee2e2; color: #be123c; }
        .category-entretenimiento { background: #fef3c7; color: #a16207; }
        .category-culturales { background: #e0e7ff; color: #4338ca; }
        .category-circos { background: #ffedd5; color: #c2410c; }
        .category-default { background: #e2e8f0; color: #334155; }

        .event-description {
            color: var(--text-soft);
            line-height: 1.55;
            font-size: 14px;
            min-height: 66px;
        }

        .meta-list {
            list-style: none;
            display: grid;
            gap: 0.75rem;
            margin: 0;
            padding: 0;
        }

        .meta-item {
            font-size: 13px;
            color: #475569;
        }

        .meta-item strong {
            color: var(--text-main);
            display: block;
            margin-bottom: 0.15rem;
        }

        .event-actions {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 0.75rem;
            margin-top: auto;
        }

        .event-actions form {
            margin: 0;
        }

        .event-actions .btn {
            border-radius: 10px;
            font-size: 14px;
            font-weight: 600;
            padding: 0.7rem 1rem;
        }

        .empty-events {
            margin-top: 1.5rem;
            background: #fff;
            border: 1px solid var(--line);
            border-radius: 12px;
            padding: 2.5rem 1.5rem;
            text-align: center;
            color: #64748b;
        }

        @@media (max-width: 1200px) {
            .event-grid { grid-template-columns: repeat(2, 1fr); }
        }

        @@media (max-width: 900px) {
            body { flex-direction: column; }
            .sidebar { width: 100%; }
            .stats-grid { grid-template-columns: 1fr; }
            .event-grid { grid-template-columns: 1fr; }
            .main-content { padding: 1.5rem; }
        }

        @@media (max-width: 640px) {
            .event-actions { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body>
    <aside class="sidebar">
        <div class="sidebar-header">
            <div class="brand-name">CampusGo</div>
            <div class="brand-sub">Tu plataforma estudiantil</div>
        </div>
        <ul class="sidebar-menu">
            <li>
                <a href="/Account/Dashboard">
                    <svg class="menu-icon" viewBox="0 0 24 24"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
                    Inicio
                </a>
            </li>
            <li>
                <a href="/Tareas">
                    <svg class="menu-icon" viewBox="0 0 24 24"><polyline points="9 11 12 14 22 4"></polyline><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path></svg>
                    Tareas
                </a>
            </li>
            <li>
                <a href="/Lugares">
                    <svg class="menu-icon" viewBox="0 0 24 24"><path d="M17 3v18"></path><path d="M4 15h16"></path><path d="M3 3l18 18"></path><path d="M7 8l-4 4"></path></svg>
                    Lugares
                </a>
            </li>
            <li>
                <a href="/Eventos" class="active">
                    <svg class="menu-icon" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                    Eventos
                </a>
            </li>
            <li>
                <a href="/Tips">
                    <svg class="menu-icon" viewBox="0 0 24 24"><path d="M9 21h6"></path><path d="M11 21v-3.8c-1.3-.4-2-1.7-2-3.1 0-2 1.8-3.6 4-3.6s4 1.6 4 3.6c0 1.4-.7 2.7-2 3.1V21"></path><path d="M12 2A4 4 0 0 0 8 6"></path></svg>
                    Tips
                </a>
            </li>
            <li>
                <a href="/Account/Perfil">
                    <svg class="menu-icon" viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                    Perfil
                </a>
            </li>
        </ul>
    </aside>

    <main class="main-content">
        <h1 class="header-title">Eventos</h1>
        <div class="header-date">Explora actividades académicas, sociales, deportivas y administrativas del campus.</div>

        <section class="summary-banner">
            <div class="summary-title">Agenda universitaria</div>
            <div class="summary-sub">Consulta lo próximo del campus con el mismo estilo de tu panel principal.</div>
            <div class="stats-grid">
                <div class="stat-card">
                    <div class="stat-number">@eventos.Count</div>
                    <div class="stat-label">Eventos disponibles</div>
                </div>
                <div class="stat-card">
                    <div class="stat-number">@eventos.Count(e => e.FechaInicio.Date >= DateTime.Today && e.FechaInicio.Date < DateTime.Today.AddDays(7))</div>
                    <div class="stat-label">Próximos esta semana</div>
                </div>
                <div class="stat-card">
                    <div class="stat-number">@eventos.Select(e => e.Categoria).Where(c => !string.IsNullOrWhiteSpace(c)).Distinct(StringComparer.OrdinalIgnoreCase).Count()</div>
                    <div class="stat-label">Categorías activas</div>
                </div>
            </div>
        </section>

        <h2 class="section-title">Filtrar eventos</h2>
        <section class="filters-bar">
            <div class="chip-group">
                <button type="button" class="filter-chip active" data-category="todos">Todos</button>
                <button type="button" class="filter-chip" data-category="Conciertos">Conciertos</button>
                <button type="button" class="filter-chip" data-category="Deportes">Deportes</button>
                <button type="button" class="filter-chip" data-category="Teatros">Teatros</button>
                <button type="button" class="filter-chip" data-category="Entretenimiento">Entretenimiento</button>
                <button type="button" class="filter-chip" data-category="Culturales">Culturales</button>
                <button type="button" class="filter-chip" data-category="Circos e Infantiles">Circos e Infantiles</button>
            </div>
            <select id="timeFilter" class="form-select time-select">
                <option value="todos">Todo el tiempo</option>
                <option value="hoy">Hoy</option>
                <option value="semana">Semana</option>
                <option value="mes">Mes</option>
            </select>
        </section>

        <div id="resultsCopy" class="results-copy">Mostrando @eventos.Count evento(s).</div>

        @if (eventos.Any())
        {
            <section class="event-grid" id="eventGrid">
                @foreach (var evento in eventos)
                {
                    var estaInscrito = eventosInscritos.Contains(evento.Id);
                    var categoriaNormalizada = (evento.Categoria ?? string.Empty).Trim().ToLowerInvariant();
                    var categoriaClase = categoriaNormalizada switch
                    {
                        "conciertos" => "category-conciertos",
                        "deportes" => "category-deportes",
                        "teatros" => "category-teatros",
                        "entretenimiento" => "category-entretenimiento",
                        "culturales" => "category-culturales",
                        "circos e infantiles" => "category-circos",
                        _ => "category-default"
                    };

                    <article class="event-card" data-category="@(evento.Categoria ?? string.Empty)" data-start="@evento.FechaInicio.ToString("yyyy-MM-dd")">
                        <div class="event-card-top">
                            <h3>@evento.Titulo</h3>
                            <span class="category-badge @categoriaClase">@MostrarCategoria(evento.Categoria)</span>
                        </div>

                        <p class="event-description">@evento.Descripcion</p>

                        <ul class="meta-list">
                            <li class="meta-item">
                                <strong>Fecha</strong>
                                <span>@evento.FechaInicio.ToString("dd MMM yyyy, hh:mm tt", cultura) - @evento.FechaFin.ToString("dd MMM yyyy, hh:mm tt", cultura)</span>
                            </li>
                            <li class="meta-item">
                                <strong>Ubicación</strong>
                                <span>@evento.Ubicacion</span>
                            </li>
                        </ul>

                        <div class="event-actions">
                            @if (estaInscrito)
                            {
                                <button type="button" class="btn btn-success" disabled>Registrado</button>
                            }
                            else
                            {
                                <form asp-action="Registrar" asp-route-id="@evento.Id" method="post">
                                    <button type="submit" class="btn btn-primary w-100">Asistir</button>
                                </form>
                            }
                            <a asp-action="Details" asp-route-id="@evento.Id" class="btn btn-outline-secondary">Ver detalles</a>
                        </div>
                    </article>
                }
            </section>
        }
        else
        {
            <section class="empty-events">
                <h3 class="fw-bold mb-2">No hay eventos para mostrar</h3>
                <p class="mb-0">Cuando se registren nuevas actividades, aparecerán aquí con el mismo estilo del dashboard.</p>
            </section>
        }
    </main>

    <script>
        (() => {
            const chips = Array.from(document.querySelectorAll(".filter-chip"));
            const timeFilter = document.getElementById("timeFilter");
            const cards = Array.from(document.querySelectorAll(".event-card"));
            const resultsCopy = document.getElementById("resultsCopy");
            let currentCategory = "todos";

            function isWithinRange(startDate, range) {
                if (range === "todos") return true;

                const today = new Date();
                today.setHours(0, 0, 0, 0);

                const start = new Date(startDate + "T00:00:00");
                if (Number.isNaN(start.getTime())) return true;

                if (range === "hoy") return start.getTime() === today.getTime();
                if (range === "semana") {
                    const end = new Date(today);
                    end.setDate(today.getDate() + 7);
                    return start >= today && start < end;
                }
                if (range === "mes") return start.getMonth() === today.getMonth() && start.getFullYear() === today.getFullYear();

                return true;
            }

            function applyFilters() {
                const range = timeFilter?.value ?? "todos";
                let visible = 0;

                cards.forEach(card => {
                    const category = (card.dataset.category || "").toLowerCase();
                    const startDate = card.dataset.start;
                    const categoryMatch = currentCategory === "todos" || category === currentCategory.toLowerCase();
                    const dateMatch = isWithinRange(startDate, range);
                    const show = categoryMatch && dateMatch;

                    card.style.display = show ? "" : "none";
                    if (show) visible++;
                });

                if (resultsCopy) {
                    resultsCopy.textContent = `Mostrando ${visible} evento(s).`;
                }
            }

            chips.forEach(chip => {
                chip.addEventListener("click", () => {
                    chips.forEach(item => item.classList.remove("active"));
                    chip.classList.add("active");
                    currentCategory = chip.dataset.category || "todos";
                    applyFilters();
                });
            });

            timeFilter?.addEventListener("change", applyFilters);
            applyFilters();
        })();
    </script>
</body>
</html>
